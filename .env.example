# --- connections (configure at least one) ---
BLAST_POSTGRES_URL=postgresql://user:pass@localhost:5432/appdb
BLAST_MONGODB_URL=mongodb://localhost:27017
BLAST_MONGODB_DATABASE=appdb

# --- REQUIRED in production: tickets die with the process without it ---
# openssl rand -hex 32
BLAST_TICKET_SECRET=

# --- safety policy (defaults shown) ---
BLAST_READ_ONLY=false
BLAST_MAX_AFFECTED_ROWS=1000
BLAST_MAX_SNAPSHOT_ROWS=10000
BLAST_ALLOW_UNFILTERED_WRITES=false
BLAST_ALLOW_TRUNCATE=false
BLAST_ALLOW_APPLY_WITHOUT_ROLLBACK=false
# BLAST_ALLOWED_SCHEMAS=["public"]
# BLAST_ALLOWED_COLLECTIONS=["users","orders"]

# --- runtime ---
BLAST_TICKET_TTL_SECONDS=600
BLAST_STATE_DIR=.blast-radius
BLAST_STATEMENT_TIMEOUT_MS=30000
